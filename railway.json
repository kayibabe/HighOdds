{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "npm ci && npm run db:generate && npm run build --workspace=@highodds/web"
  },
  "deploy": {
    "startCommand": "npm run start --workspace=@highodds/web",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
